{% extends "layouts/dashboard.twig" %}

{% block title %}Order Detail #{{ order.order_number }}{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-receipt me-2"></i>
            Order Detail
        </h2>
        <a href="{{ path_for('admin.orders') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Orders
        </a>
    </div>

    <!-- Order Info Card -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">Order Information</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless mb-0">
                        <tr>
                            <td class="text-muted" width="150">Order Number</td>
                            <td><strong class="text-primary">{{ order.order_number }}</strong></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Customer</td>
                            <td><strong>{{ user.username }}</strong></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Email</td>
                            <td>{{ user.email }}</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Order Date</td>
                            <td>{{ order.created_at|date('d M Y H:i') }}</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Status</td>
                            <td>
                                {% if order.status == 'success' %}
                                    <span class="badge bg-success fs-6">Success</span>
                                {% elseif order.status == 'pending' %}
                                    <span class="badge bg-warning text-dark fs-6">Pending</span>
                                {% elseif order.status == 'failed' %}
                                    <span class="badge bg-danger fs-6">Failed</span>
                                {% elseif order.status == 'cancelled' %}
                                    <span class="badge bg-secondary fs-6">Cancelled</span>
                                {% else %}
                                    <span class="badge bg-secondary fs-6">{{ order.status|capitalize }}</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">Total Amount</td>
                            <td>
                                <h4 class="mb-0 text-success">
                                    Rp {{ order.total_amount|number_format(0, ',', '.') }}
                                </h4>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">Payment Information</h5>
                </div>
                <div class="card-body">
                    {% if payment %}
                    <table class="table table-borderless mb-0">
                        <tr>
                            <td class="text-muted" width="150">Transaction ID</td>
                            <td><code>{{ payment.transaction_id }}</code></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Payment Type</td>
                            <td><strong>{{ payment.payment_type|upper }}</strong></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Amount</td>
                            <td>
                                <strong class="text-success">
                                    Rp {{ payment.gross_amount|number_format(0, ',', '.') }}
                                </strong>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">Payment Status</td>
                            <td>
                                {% if payment.status == 'success' %}
                                    <span class="badge bg-success">Success</span>
                                {% elseif payment.status == 'pending' %}
                                    <span class="badge bg-warning text-dark">Pending</span>
                                {% elseif payment.status == 'failed' %}
                                    <span class="badge bg-danger">Failed</span>
                                {% else %}
                                    <span class="badge bg-secondary">{{ payment.status|capitalize }}</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">Payment Date</td>
                            <td>{{ payment.created_at|date('d M Y H:i') }}</td>
                        </tr>
                        {% if payment.snap_token %}
                        <tr>
                            <td class="text-muted">Snap Token</td>
                            <td><small class="text-muted">{{ payment.snap_token|slice(0, 20) }}...</small></td>
                        </tr>
                        {% endif %}
                    </table>
                    {% else %}
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-exclamation-triangle"></i>
                        No payment record found for this order
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Order Items -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold">Order Items</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="px-4">Product Name</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if order.items is empty %}
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                No items found
                            </td>
                        </tr>
                        {% else %}
                            {% for item in order.items %}
                            <tr>
                                <td class="px-4">
                                    <strong>{{ item.product_name }}</strong>
                                </td>
                                <td>Rp {{ item.price|number_format(0, ',', '.') }}</td>
                                <td>
                                    <span class="badge bg-primary">{{ item.quantity }}</span>
                                </td>
                                <td>
                                    <strong class="text-success">
                                        Rp {{ item.subtotal|number_format(0, ',', '.') }}
                                    </strong>
                                </td>
                            </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                    <tfoot class="bg-light">
                        <tr>
                            <th colspan="3" class="px-4 text-end">Total:</th>
                            <th>
                                <h5 class="mb-0 text-success">
                                    Rp {{ order.total_amount|number_format(0, ',', '.') }}
                                </h5>
                            </th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}