{% extends "layouts/dashboard.twig" %}

{% block title %}Dashboard Admin{% endblock %}

{% block content %}
<div class="container-fluid">
    <!-- Welcome Card -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-gradient rounded-circle p-3 me-3">
                            <i class="bi bi-person-circle text-white" style="font-size: 2rem;"></i>
                        </div>
                        <div>
                            <h3 class="mb-1 fw-bold text-dark">Selamat Datang, {{ session.user.username ?? 'Admin' }}! 👋</h3>
                            <p class="text-muted mb-0">Kelola sistem payment gateway Educa Studio dengan mudah</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Total Orders</p>
                            <h3 class="fw-bold text-dark mb-0">{{ stats.total_orders ?? 0 }}</h3>
                            <small class="text-success">
                                <i class="bi bi-check-circle"></i> {{ stats.success_orders ?? 0 }} Success
                            </small>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded p-3">
                            <i class="bi bi-box-seam text-primary" style="font-size: 1.5rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Total Revenue</p>
                            <h3 class="fw-bold text-dark mb-0">Rp {{ (stats.total_revenue ?? 0)|number_format(0, ',', '.') }}</h3>
                            <small class="text-success">
                                <i class="bi bi-arrow-up"></i> Paid Orders
                            </small>
                        </div>
                        <div class="bg-success bg-opacity-10 rounded p-3">
                            <i class="bi bi-currency-dollar text-success" style="font-size: 1.5rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Pending Orders</p>
                            <h3 class="fw-bold text-dark mb-0">{{ stats.pending_orders ?? 0 }}</h3>
                            <small class="text-warning">
                                <i class="bi bi-exclamation-circle"></i> Perlu diproses
                            </small>
                        </div>
                        <div class="bg-warning bg-opacity-10 rounded p-3">
                            <i class="bi bi-clock-history text-warning" style="font-size: 1.5rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Total Users</p>
                            <h3 class="fw-bold text-dark mb-0">{{ stats.total_users ?? 0 }}</h3>
                            <small class="text-info">
                                <i class="bi bi-people"></i> Registered
                            </small>
                        </div>
                        <div class="bg-info bg-opacity-10 rounded p-3">
                            <i class="bi bi-people-fill text-info" style="font-size: 1.5rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Orders -->
    <div class="row g-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-clock-history text-primary me-2"></i>
                        Order Terbaru
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="border-0 px-4">Order Number</th>
                                    <th class="border-0">Customer</th>
                                    <th class="border-0">Amount</th>
                                    <th class="border-0">Status</th>
                                    <th class="border-0">Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if recent_orders is empty %}
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                                        <p class="mt-2">Belum ada order</p>
                                    </td>
                                </tr>
                                {% else %}
                                    {% for order in recent_orders %}
                                    <tr>
                                        <td class="px-4">
                                            <strong>{{ order.order_number }}</strong>
                                        </td>
                                        <td>{{ order.username }}</td>
                                        <td class="fw-semibold">Rp {{ order.total_amount|number_format(0, ',', '.') }}</td>
                                        <td>
                                            {% if order.status == 'success' %}
                                                <span class="badge bg-success">Success</span>
                                            {% elseif order.status == 'pending' %}
                                                <span class="badge bg-warning text-dark">Pending</span>
                                            {% elseif order.status == 'failed' %}
                                                <span class="badge bg-danger">Failed</span>
                                            {% else %}
                                                <span class="badge bg-secondary">{{ order.status|capitalize }}</span>
                                            {% endif %}
                                        </td>
                                        <td>{{ order.created_at|date('d M Y H:i') }}</td>
                                    </tr>
                                    {% endfor %}
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer bg-white border-top-0 py-3 text-center">
                        <a href="{{ path_for('admin.orders') }}" class="btn btn-outline-primary btn-sm">
                            Lihat Semua Order <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}