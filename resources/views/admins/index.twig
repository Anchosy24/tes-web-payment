{% extends "layouts/dashboard.twig" %}

{% block title %}Dashboard Admin{% endblock %}

{% block content %}
<div class="container-fluid">
    <!-- Welcome Card -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-gradient rounded-circle p-3 me-3">
                            <i class="bi bi-person-circle text-white" style="font-size: 2rem;"></i>
                        </div>
                        <div>
                            <h3 class="mb-1 fw-bold text-dark">Selamat Datang, {{ session.user.username ?? 'Admin' }}! 👋</h3>
                            <p class="text-muted mb-0">Kelola sistem payment gateway Educa Studio dengan mudah</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Total Orders</p>
                            <h3 class="fw-bold text-dark mb-0">1,245</h3>
                            <small class="text-success">
                                <i class="bi bi-arrow-up"></i> 12% dari bulan lalu
                            </small>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded p-3">
                            <i class="bi bi-box-seam text-primary" style="font-size: 1.5rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Total Revenue</p>
                            <h3 class="fw-bold text-dark mb-0">Rp 45.5M</h3>
                            <small class="text-success">
                                <i class="bi bi-arrow-up"></i> 8% dari bulan lalu
                            </small>
                        </div>
                        <div class="bg-success bg-opacity-10 rounded p-3">
                            <i class="bi bi-currency-dollar text-success" style="font-size: 1.5rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Pending Payments</p>
                            <h3 class="fw-bold text-dark mb-0">23</h3>
                            <small class="text-warning">
                                <i class="bi bi-exclamation-circle"></i> Perlu diproses
                            </small>
                        </div>
                        <div class="bg-warning bg-opacity-10 rounded p-3">
                            <i class="bi bi-clock-history text-warning" style="font-size: 1.5rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Active Users</p>
                            <h3 class="fw-bold text-dark mb-0">892</h3>
                            <small class="text-info">
                                <i class="bi bi-people"></i> Total pengguna
                            </small>
                        </div>
                        <div class="bg-info bg-opacity-10 rounded p-3">
                            <i class="bi bi-people-fill text-info" style="font-size: 1.5rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Orders & Quick Actions -->
    <div class="row g-4">
        <!-- Recent Orders -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-clock-history text-primary me-2"></i>
                        Order Terbaru
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="border-0 px-4">Order ID</th>
                                    <th class="border-0">Customer</th>
                                    <th class="border-0">Amount</th>
                                    <th class="border-0">Status</th>
                                    <th class="border-0">Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="px-4">#ORD-001</td>
                                    <td>John Doe</td>
                                    <td class="fw-semibold">Rp 250,000</td>
                                    <td><span class="badge bg-success">Paid</span></td>
                                    <td>09 Jan 2026</td>
                                </tr>
                                <tr>
                                    <td class="px-4">#ORD-002</td>
                                    <td>Jane Smith</td>
                                    <td class="fw-semibold">Rp 150,000</td>
                                    <td><span class="badge bg-warning text-dark">Pending</span></td>
                                    <td>09 Jan 2026</td>
                                </tr>
                                <tr>
                                    <td class="px-4">#ORD-003</td>
                                    <td>Mike Johnson</td>
                                    <td class="fw-semibold">Rp 350,000</td>
                                    <td><span class="badge bg-success">Paid</span></td>
                                    <td>08 Jan 2026</td>
                                </tr>
                                <tr>
                                    <td class="px-4">#ORD-004</td>
                                    <td>Sarah Williams</td>
                                    <td class="fw-semibold">Rp 180,000</td>
                                    <td><span class="badge bg-danger">Failed</span></td>
                                    <td>08 Jan 2026</td>
                                </tr>
                                <tr>
                                    <td class="px-4">#ORD-005</td>
                                    <td>David Brown</td>
                                    <td class="fw-semibold">Rp 420,000</td>
                                    <td><span class="badge bg-success">Paid</span></td>
                                    <td>07 Jan 2026</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer bg-white border-top-0 py-3 text-center">
                        <a href="/admin/orders" class="btn btn-outline-primary btn-sm">
                            Lihat Semua Order <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
$(document).ready(function() {
    // Show settings modal
    window.showSettings = function() {
        Swal.fire({
            title: 'Pengaturan',
            text: 'Fitur pengaturan akan segera hadir!',
            icon: 'info',
            confirmButtonText: 'OK',
            confirmButtonColor: '#0d6efd'
        });
    }

    // Animate statistics on page load
    $('.card').each(function(index) {
        $(this).css({
            'opacity': '0',
            'transform': 'translateY(20px)'
        }).delay(index * 100).animate({
            'opacity': '1'
        }, 500, function() {
            $(this).css('transform', 'translateY(0)');
        });
    });
});
</script>
{% endblock %}