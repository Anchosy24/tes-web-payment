{% extends "layouts/dashboard.twig" %}

{% block title %}Payment History{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-credit-card me-2"></i>
            Payment History
        </h2>
    </div>

    <!-- Filter -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="GET" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Filter by Status</label>
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="">All Status</option>
                        <option value="pending" {% if current_status == 'pending' %}selected{% endif %}>Pending</option>
                        <option value="settlement" {% if current_status == 'settlement' %}selected{% endif %}>Settlement</option>
                        <option value="deny" {% if current_status == 'deny' %}selected{% endif %}>Deny</option>
                        <option value="cancel" {% if current_status == 'cancel' %}selected{% endif %}>Cancel</option>
                        <option value="expire" {% if current_status == 'expire' %}selected{% endif %}>Expire</option>
                    </select>
                </div>
            </form>
        </div>
    </div>

    <!-- Payments Table -->
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="px-4">Transaction ID</th>
                            <th>Order Number</th>
                            <th>Customer</th>
                            <th>Payment Type</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if payments is empty %}
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="bi bi-credit-card-2-front" style="font-size: 4rem; color: #ddd;"></i>
                                <p class="text-muted mt-3">Tidak ada payment</p>
                            </td>
                        </tr>
                        {% else %}
                            {% for payment in payments %}
                            <tr>
                                <td class="px-4">
                                    <code>{{ payment.transaction_id ?? '-' }}</code>
                                </td>
                                <td>
                                    <strong class="text-primary">{{ payment.order_number }}</strong>
                                </td>
                                <td>
                                    {{ payment.username }}<br>
                                    <small class="text-muted">{{ payment.email }}</small>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">
                                        {{ payment.payment_type|upper ?? 'N/A' }}
                                    </span>
                                </td>
                                <td><strong>Rp {{ payment.gross_amount|number_format(0, ',', '.') }}</strong></td>
                                <td>
                                    {% if payment.status == 'settlement' or payment.status == 'capture' %}
                                        <span class="badge bg-success">{{ payment.status|capitalize }}</span>
                                    {% elseif payment.status == 'pending' %}
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    {% elseif payment.status == 'deny' or payment.status == 'cancel' or payment.status == 'expire' %}
                                        <span class="badge bg-danger">{{ payment.status|capitalize }}</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ payment.status|capitalize }}</span>
                                    {% endif %}
                                </td>
                                <td>{{ payment.created_at|date('d M Y H:i') }}</td>
                            </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
            
            <!-- Pagination -->
            {% if pagination.total_pages > 1 %}
            <div class="card-footer bg-white">
                <nav>
                    <ul class="pagination mb-0 justify-content-center">
                        {% for i in 1..pagination.total_pages %}
                        <li class="page-item {% if i == pagination.page %}active{% endif %}">
                            <a class="page-link" href="?page={{ i }}{% if current_status %}&status={{ current_status }}{% endif %}">
                                {{ i }}
                            </a>
                        </li>
                        {% endfor %}
                    </ul>
                </nav>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}