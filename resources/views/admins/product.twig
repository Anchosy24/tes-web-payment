{% extends "layouts/dashboard.twig" %}

{% block title %}Manage Products{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-box-seam me-2"></i>
            Manage Products
        </h2>
        <a href="{{ path_for('admin.products.create') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Add New Product
        </a>
    </div>

    <!-- Search -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="GET" class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <input type="text" name="search" class="form-control" placeholder="Search products..." value="{{ search }}">
                        <button class="btn btn-primary" type="submit">
                            <i class="bi bi-search"></i> Search
                        </button>
                        {% if search %}
                        <a href="{{ path_for('admin.products') }}" class="btn btn-secondary">
                            <i class="bi bi-x"></i> Clear
                        </a>
                        {% endif %}
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Products Grid -->
    <div class="row g-4">
        {% if products is empty %}
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 4rem; color: #ddd;"></i>
                    <p class="text-muted mt-3 mb-0">
                        {% if search %}
                            Tidak ada produk yang ditemukan dengan kata kunci "{{ search }}"
                        {% else %}
                            Belum ada produk. Klik "Add New Product" untuk menambahkan.
                        {% endif %}
                    </p>
                </div>
            </div>
        </div>
        {% else %}
            {% for product in products %}
            <div class="col-md-4 col-lg-3">
                <div class="card h-100">
                    {% if product.image_url %}
                    <img src="{{ product.image_url }}" class="card-img-top" alt="{{ product.product_name }}" style="height: 200px; object-fit: cover;">
                    {% else %}
                    <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                        <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                    </div>
                    {% endif %}
                    
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title">{{ product.product_name }}</h6>
                        <p class="card-text text-muted small mb-2">
                            {{ product.description|slice(0, 80) }}{% if product.description|length > 80 %}...{% endif %}
                        </p>
                        
                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong class="text-success">Rp {{ product.price|number_format(0, ',', '.') }}</strong>
                                <span class="badge {% if product.stock > 10 %}bg-success{% elseif product.stock > 0 %}bg-warning text-dark{% else %}bg-danger{% endif %}">
                                    Stock: {{ product.stock }}
                                </span>
                            </div>
                            
                            <div class="btn-group w-100">
                                <a href="{{ path_for('admin.products.edit', {id: product.id}) }}" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <button onclick="deleteProduct({{ product.id }}, '{{ product.product_name }}')" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        {% endif %}
    </div>

    <!-- Pagination -->
    {% if pagination.total_pages > 1 %}
    <div class="card mt-4">
        <div class="card-body">
            <nav>
                <ul class="pagination mb-0 justify-content-center">
                    {% for i in 1..pagination.total_pages %}
                    <li class="page-item {% if i == pagination.page %}active{% endif %}">
                        <a class="page-link" href="?page={{ i }}{% if search %}&search={{ search }}{% endif %}">
                            {{ i }}
                        </a>
                    </li>
                    {% endfor %}
                </ul>
            </nav>
        </div>
    </div>
    {% endif %}
</div>

<!-- Delete Form (Hidden) -->
<form id="deleteForm" method="POST" style="display: none;">
    <input type="hidden" name="_method" value="DELETE">
</form>

{% endblock %}

{% block scripts %}
<script>
function deleteProduct(id, name) {
    Swal.fire({
        title: 'Hapus Produk?',
        html: `Apakah Anda yakin ingin menghapus produk:<br><strong>${name}</strong>?`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Ya, Hapus!',
        cancelButtonText: 'Batal'
    }).then((result) => {
        if (result.isConfirmed) {
            const form = document.getElementById('deleteForm');
            form.action = '{{ path_for('admin.products') }}/' + id + '/delete';
            form.submit();
        }
    });
}
</script>
{% endblock %}