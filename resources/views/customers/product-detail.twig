{% extends "layouts/home.twig" %}

{% block title %}{{ product.product_name }}{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="row mb-3">
        <div class="col-12">
            <a href="{{ path_for('customer.home') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Kembali ke Catalog
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Product Image -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                {% if product.image_url %}
                <img src="{{ product.image_url }}" class="card-img-top" alt="{{ product.product_name }}" style="height: 500px; object-fit: cover; border-radius: 12px;">
                {% else %}
                <div class="bg-light d-flex align-items-center justify-content-center" style="height: 500px; border-radius: 12px;">
                    <i class="bi bi-image text-muted" style="font-size: 8rem;"></i>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Product Info -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h1 class="mb-3 fw-bold">{{ product.product_name }}</h1>
                    
                    <div class="mb-4">
                        <span class="badge {% if product.stock > 10 %}bg-success{% elseif product.stock > 0 %}bg-warning text-dark{% else %}bg-danger{% endif %} fs-6">
                            <i class="bi bi-box"></i> Stock: {{ product.stock }}
                        </span>
                    </div>

                    <div class="mb-4">
                        <h2 class="text-success fw-bold">
                            Rp {{ product.price|number_format(0, ',', '.') }}
                        </h2>
                    </div>

                    <hr>

                    <div class="mb-4">
                        <h5 class="fw-bold mb-3">Deskripsi</h5>
                        <p class="text-muted">
                            {{ product.description ?? 'Tidak ada deskripsi untuk produk ini.' }}
                        </p>
                    </div>

                    <hr>

                    <!-- Add to Cart Form -->
                    {% if product.stock > 0 %}
                    <form method="POST" action="{{ path_for('customer.cart.add') }}" id="addToCartForm">
                        <input type="hidden" name="product_id" value="{{ product.id }}">
                        
                        <div class="mb-4">
                            <label class="form-label fw-bold">Jumlah</label>
                            <div class="input-group" style="max-width: 200px;">
                                <button class="btn btn-outline-secondary" type="button" onclick="decreaseQty()">
                                    <i class="bi bi-dash"></i>
                                </button>
                                <input 
                                    type="number" 
                                    class="form-control text-center" 
                                    name="quantity" 
                                    id="quantity" 
                                    value="1" 
                                    min="1" 
                                    max="{{ product.stock }}"
                                    required
                                >
                                <button class="btn btn-outline-secondary" type="button" onclick="increaseQty()">
                                    <i class="bi bi-plus"></i>
                                </button>
                            </div>
                            <small class="text-muted">Max: {{ product.stock }} pcs</small>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-cart-plus"></i> Tambah ke Keranjang
                            </button>
                            <a href="{{ path_for('customer.home') }}" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Lanjut Belanja
                            </a>
                        </div>
                    </form>
                    {% else %}
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Stock Habis!</strong> Produk ini sedang tidak tersedia.
                    </div>
                    <a href="{{ path_for('customer.home') }}" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-arrow-left"></i> Kembali ke Catalog
                    </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
const maxStock = {{ product.stock }};

function decreaseQty() {
    const input = document.getElementById('quantity');
    let value = parseInt(input.value);
    if (value > 1) {
        input.value = value - 1;
    }
}

function increaseQty() {
    const input = document.getElementById('quantity');
    let value = parseInt(input.value);
    if (value < maxStock) {
        input.value = value + 1;
    }
}

document.getElementById('addToCartForm').addEventListener('submit', function(e) {
    const quantity = parseInt(document.getElementById('quantity').value);
    
    if (quantity < 1 || quantity > maxStock) {
        e.preventDefault();
        Swal.fire({
            icon: 'warning',
            title: 'Jumlah Tidak Valid',
            text: `Jumlah harus antara 1 - ${maxStock}`,
            confirmButtonColor: '#0d6efd'
        });
        return false;
    }
    
    Swal.fire({
        title: 'Menambahkan ke keranjang...',
        allowOutsideClick: false,
        didOpen: () => {
            Swal.showLoading();
        }
    });
});
</script>
{% endblock %}