{% extends "layouts/home.twig" %}

{% block title %}Detail Order #{{ order.order_number }}{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="row mb-3">
        <div class="col-12">
            <a href="{{ path_for('customer.orders') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Kembali ke Pesanan
            </a>
        </div>
    </div>

    <!-- Order Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h2 class="mb-1 fw-bold">
                                <i class="bi bi-receipt text-primary"></i> {{ order.order_number }}
                            </h2>
                            <p class="text-muted mb-0">
                                <i class="bi bi-calendar"></i> {{ order.created_at|date('d M Y H:i') }}
                            </p>
                        </div>
                        <div class="col-md-6 text-md-end mt-3 mt-md-0">
                            {% if order.status == 'success' %}
                                <span class="badge bg-success fs-5 px-4 py-2">
                                    <i class="bi bi-check-circle"></i> Success
                                </span>
                            {% elseif order.status == 'pending' %}
                                <span class="badge bg-warning text-dark fs-5 px-4 py-2">
                                    <i class="bi bi-clock-history"></i> Pending
                                </span>
                            {% elseif order.status == 'failed' %}
                                <span class="badge bg-danger fs-5 px-4 py-2">
                                    <i class="bi bi-x-circle"></i> Failed
                                </span>
                            {% else %}
                                <span class="badge bg-secondary fs-5 px-4 py-2">{{ order.status|capitalize }}</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Order Items -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-box-seam"></i> Item Pesanan
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="px-4">Produk</th>
                                    <th>Harga</th>
                                    <th>Qty</th>
                                    <th>Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in order.items %}
                                <tr>
                                    <td class="px-4">
                                        <strong>{{ item.product_name }}</strong>
                                    </td>
                                    <td>Rp {{ item.price|number_format(0, ',', '.') }}</td>
                                    <td>
                                        <span class="badge bg-primary">{{ item.quantity }}</span>
                                    </td>
                                    <td>
                                        <strong class="text-success">
                                            Rp {{ item.subtotal|number_format(0, ',', '.') }}
                                        </strong>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                            <tfoot class="bg-light">
                                <tr>
                                    <th colspan="3" class="px-4 text-end">Total:</th>
                                    <th>
                                        <h5 class="text-success mb-0">
                                            Rp {{ order.total_amount|number_format(0, ',', '.') }}
                                        </h5>
                                    </th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Payment Info -->
            {% if payment %}
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-credit-card"></i> Informasi Pembayaran
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <small class="text-muted d-block">Transaction ID</small>
                            <code class="fs-6">{{ payment.transaction_id }}</code>
                        </div>
                        <div class="col-md-6 mb-3">
                            <small class="text-muted d-block">Payment Type</small>
                            <strong>{{ payment.payment_type|upper }}</strong>
                        </div>
                        <div class="col-md-6 mb-3">
                            <small class="text-muted d-block">Amount</small>
                            <h5 class="text-success mb-0">
                                Rp {{ payment.gross_amount|number_format(0, ',', '.') }}
                            </h5>
                        </div>
                        <div class="col-md-6 mb-3">
                            <small class="text-muted d-block">Payment Status</small>
                            {% if payment.status == 'settlement' or payment.status == 'capture' %}
                                <span class="badge bg-success fs-6">{{ payment.status|capitalize }}</span>
                            {% elseif payment.status == 'pending' %}
                                <span class="badge bg-warning text-dark fs-6">Pending</span>
                            {% else %}
                                <span class="badge bg-danger fs-6">{{ payment.status|capitalize }}</span>
                            {% endif %}
                        </div>
                        <div class="col-12">
                            <small class="text-muted d-block">Payment Date</small>
                            <strong>{{ payment.created_at|date('d M Y H:i') }}</strong>
                        </div>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="card border-0 shadow-sm border-warning">
                <div class="card-body">
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Belum Ada Pembayaran</strong>
                        <p class="mb-0">Order ini belum dibayar. Silakan lakukan pembayaran untuk melanjutkan.</p>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>

        <!-- Order Summary -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">Ringkasan Order</h5>
                    
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Order Number</span>
                            <strong>{{ order.order_number }}</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Total Item</span>
                            <strong>{{ order.items|length }} produk</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tanggal Order</span>
                            <strong>{{ order.created_at|date('d/m/Y') }}</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Status</span>
                            <strong class="text-uppercase">{{ order.status }}</strong>
                        </div>
                    </div>
                    
                    <hr>
                    
                    <div class="d-flex justify-content-between mb-4">
                        <h5 class="mb-0">Total Bayar</h5>
                        <h4 class="mb-0 text-success fw-bold">
                            Rp {{ order.total_amount|number_format(0, ',', '.') }}
                        </h4>
                    </div>
                    
                    <div class="d-grid gap-2">
                        {% if order.status == 'pending' %}
                        <a href="{{ path_for('customer.payment', {id: order.id}) }}" class="btn btn-primary btn-lg">
                            <i class="bi bi-credit-card"></i> Bayar Sekarang
                        </a>
                        {% endif %}
                        
                        <a href="{{ path_for('customer.orders') }}" class="btn btn-outline-secondary">
                            <i class="bi bi-box-seam"></i> Lihat Pesanan Lain
                        </a>
                        <a href="{{ path_for('customer.home') }}" class="btn btn-outline-primary">
                            <i class="bi bi-shop"></i> Belanja Lagi
                        </a>
                    </div>
                    
                    {% if order.status == 'success' %}
                    <div class="mt-4 p-3 bg-success bg-opacity-10 rounded text-center">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
                        <h6 class="mt-2 mb-0 text-success fw-bold">Pembayaran Berhasil!</h6>
                        <small class="text-muted">Terima kasih atas pembelian Anda</small>
                    </div>
                    {% elseif order.status == 'pending' %}
                    <div class="alert alert-warning mt-3 mb-0">
                        <i class="bi bi-clock-history"></i>
                        <small>Selesaikan pembayaran dalam 24 jam</small>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}