{% extends "layouts/home.twig" %}

{% block title %}Pesanan Saya{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <h2 class="mb-1 fw-bold">
                                <i class="bi bi-box-seam text-primary"></i> Pesanan Saya
                            </h2>
                            <p class="text-muted mb-0">Kelola dan pantau status pesanan Anda</p>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="{{ path_for('customer.home') }}" class="btn btn-primary">
                                <i class="bi bi-shop"></i> Belanja Lagi
                            </a>
                            <a href="{{ path_for('customer.cart') }}" class="btn btn-outline-primary">
                                <i class="bi bi-cart3"></i> Keranjang
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if orders is empty %}
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 6rem; color: #ddd;"></i>
                    <h3 class="mt-4 text-muted">Belum Ada Pesanan</h3>
                    <p class="text-muted mb-4">Anda belum memiliki riwayat pesanan</p>
                    <a href="{{ path_for('customer.home') }}" class="btn btn-primary btn-lg">
                        <i class="bi bi-shop"></i> Mulai Belanja
                    </a>
                </div>
            </div>
        </div>
    </div>
    {% else %}
    <div class="row g-4">
        {% for order in orders %}
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h6 class="mb-0 fw-bold">
                                <i class="bi bi-receipt"></i> {{ order.order_number }}
                            </h6>
                            <small class="text-muted">
                                <i class="bi bi-calendar"></i> {{ order.created_at|date('d M Y H:i') }}
                            </small>
                        </div>
                        <div class="col-md-6 text-md-end mt-2 mt-md-0">
                            {% if order.status == 'success' %}
                                <span class="badge bg-success fs-6">
                                    <i class="bi bi-check-circle"></i> Success
                                </span>
                            {% elseif order.status == 'pending' %}
                                <span class="badge bg-warning text-dark fs-6">
                                    <i class="bi bi-clock-history"></i> Pending
                                </span>
                            {% elseif order.status == 'failed' %}
                                <span class="badge bg-danger fs-6">
                                    <i class="bi bi-x-circle"></i> Failed
                                </span>
                            {% elseif order.status == 'cancelled' %}
                                <span class="badge bg-secondary fs-6">
                                    <i class="bi bi-slash-circle"></i> Cancelled
                                </span>
                            {% else %}
                                <span class="badge bg-secondary fs-6">{{ order.status|capitalize }}</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <div class="d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 rounded p-3 me-3">
                                    <i class="bi bi-box-seam text-primary" style="font-size: 2rem;"></i>
                                </div>
                                <div>
                                    <h5 class="mb-1 text-success fw-bold">
                                        Rp {{ order.total_amount|number_format(0, ',', '.') }}
                                    </h5>
                                    <small class="text-muted">Total Pembayaran</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 text-md-end mt-3 mt-md-0">
                            <div class="d-grid gap-2">
                                <a href="{{ path_for('customer.order.detail', {id: order.id}) }}" class="btn btn-outline-primary">
                                    <i class="bi bi-eye"></i> Lihat Detail
                                </a>
                                {% if order.status == 'pending' %}
                                <a href="{{ path_for('customer.payment', {id: order.id}) }}" class="btn btn-primary">
                                    <i class="bi bi-credit-card"></i> Bayar Sekarang
                                </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <!-- Order Info -->
                    <div class="mt-3 pt-3 border-top">
                        <div class="row">
                            <div class="col-6 col-md-3 mb-2">
                                <small class="text-muted d-block">Order ID</small>
                                <strong>#{{ order.id }}</strong>
                            </div>
                            <div class="col-6 col-md-3 mb-2">
                                <small class="text-muted d-block">Tanggal</small>
                                <strong>{{ order.created_at|date('d/m/Y') }}</strong>
                            </div>
                            <div class="col-6 col-md-3 mb-2">
                                <small class="text-muted d-block">Waktu</small>
                                <strong>{{ order.created_at|date('H:i') }}</strong>
                            </div>
                            <div class="col-6 col-md-3 mb-2">
                                <small class="text-muted d-block">Status</small>
                                <strong class="text-uppercase">{{ order.status }}</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endblock %}