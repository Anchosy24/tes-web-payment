{% extends "layouts/home.twig" %}

{% block title %}Product Catalog{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <h2 class="mb-1 fw-bold">
                                <i class="bi bi-shop text-primary"></i> Product Catalog
                            </h2>
                            <p class="text-muted mb-0">Temukan produk terbaik untuk kebutuhan Anda</p>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="{{ path_for('customer.cart') }}" class="btn btn-primary">
                                <i class="bi bi-cart3"></i> Keranjang 
                                {% if session.cart %}
                                    <span class="badge bg-danger">{{ session.cart|length }}</span>
                                {% endif %}
                            </a>
                            <a href="{{ path_for('customer.orders') }}" class="btn btn-outline-primary">
                                <i class="bi bi-box-seam"></i> Pesanan Saya
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <form method="GET" class="row g-3">
                        <div class="col-12">
                            <div class="input-group input-group-lg">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input 
                                    type="text" 
                                    name="search" 
                                    class="form-control" 
                                    placeholder="Cari produk..." 
                                    value="{{ search }}"
                                >
                                <button class="btn btn-primary" type="submit">Cari</button>
                                {% if search %}
                                <a href="{{ path_for('customer.home') }}" class="btn btn-secondary">
                                    <i class="bi bi-x"></i> Clear
                                </a>
                                {% endif %}
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Products Grid -->
    <div class="row g-4">
        {% if products is empty %}
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 5rem; color: #ddd;"></i>
                    <h4 class="mt-3 text-muted">
                        {% if search %}
                            Produk tidak ditemukan
                        {% else %}
                            Belum ada produk tersedia
                        {% endif %}
                    </h4>
                    {% if search %}
                    <a href="{{ path_for('customer.home') }}" class="btn btn-primary mt-3">
                        Lihat Semua Produk
                    </a>
                    {% endif %}
                </div>
            </div>
        </div>
        {% else %}
            {% for product in products %}
            <div class="col-md-6 col-lg-4 col-xl-3">
                <div class="card h-100 border-0 shadow-sm">
                    {% if product.image_url %}
                    <img src="{{ product.image_url }}" class="card-img-top" alt="{{ product.product_name }}" style="height: 250px; object-fit: cover;">
                    {% else %}
                    <div class="bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
                        <i class="bi bi-image text-muted" style="font-size: 4rem;"></i>
                    </div>
                    {% endif %}
                    
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-truncate" title="{{ product.product_name }}">
                            {{ product.product_name }}
                        </h5>
                        <p class="card-text text-muted small mb-3">
                            {{ product.description|slice(0, 100) }}{% if product.description|length > 100 %}...{% endif %}
                        </p>
                        
                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4 class="text-success mb-0 fw-bold">
                                    Rp {{ product.price|number_format(0, ',', '.') }}
                                </h4>
                                <span class="badge {% if product.stock > 10 %}bg-success{% elseif product.stock > 0 %}bg-warning text-dark{% else %}bg-danger{% endif %}">
                                    Stock: {{ product.stock }}
                                </span>
                            </div>
                            
                            <div class="d-grid gap-2">
                                <a href="{{ path_for('customer.product.detail', {id: product.id}) }}" class="btn btn-outline-primary">
                                    <i class="bi bi-eye"></i> Lihat Detail
                                </a>
                                <form method="POST" action="{{ path_for('customer.cart.add') }}" onsubmit="return addToCartQuick(event, '{{ product.product_name }}')">
                                    <input type="hidden" name="product_id" value="{{ product.id }}">
                                    <input type="hidden" name="quantity" value="1">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="bi bi-cart-plus"></i> Tambah ke Keranjang
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        {% endif %}
    </div>

    <!-- Pagination -->
    {% if pagination.total_pages > 1 %}
    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <nav>
                        <ul class="pagination mb-0 justify-content-center">
                            {% for i in 1..pagination.total_pages %}
                            <li class="page-item {% if i == pagination.page %}active{% endif %}">
                                <a class="page-link" href="?page={{ i }}{% if search %}&search={{ search }}{% endif %}">
                                    {{ i }}
                                </a>
                            </li>
                            {% endfor %}
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}

{% block scripts %}
<script>
function addToCartQuick(event, productName) {
    event.preventDefault();
    const form = event.target;
    
    Swal.fire({
        title: 'Menambahkan ke keranjang...',
        allowOutsideClick: false,
        didOpen: () => {
            Swal.showLoading();
        }
    });
    
    setTimeout(() => {
        form.submit();
    }, 500);
    
    return false;
}
</script>
{% endblock %}